                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                      "const h = pm.response.json();",
                      "pm.test('status is ok', () => pm.expect(h.status).to.eql('ok'));",
                      "console.log('database:', JSON.stringify(h.database), '| queue:', JSON.stringify(h.queue), '| problems:', h.problems);"
                    ]
                  }
                }
              ]
