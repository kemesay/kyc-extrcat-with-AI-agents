    {
      "name": "Universal Engine (any country / script / ID type)",
      "description": "Universal engine — any country, script or ID type. Every request runs the FULL agent team (fast_scanner → field_extractor + transcriber → accuracy_verifier → layout_analyzer → supervisor) and the deterministic verification layer, through the durable PostgreSQL + pgvector queue. Choose a priority per request: live > online > batch > bulk. Sync calls take ~2 min on the MacBook: raise Postman's request timeout to at least 300000 ms.",
      "item": [
        {
          "name": "1. Service",
          "item": [
            {
              "name": "Health (readiness)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/universal/health",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "universal",
                    "health"
                  ]
